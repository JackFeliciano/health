[Unit]
Description=Health demo
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/health
Environment=HEALTH_BASE=/health/
ExecStart=/usr/bin/php -S 127.0.0.1:8110 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/health
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
